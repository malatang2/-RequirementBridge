{
  "name": "feedback_eval",
  "description": "反馈聚类评测集（对应 SOW §6.2 模块三）",
  "samples": [
    {
      "id": "f1",
      "input": [
        "登录总是失败，很烦",
        "验证码收不到",
        "登录后经常掉线",
        "界面很好看，点赞",
        "颜色搭配很舒服",
        "加载速度太慢了",
        "打开页面要等很久",
        "希望增加导出功能",
        "想要自定义字段",
        "客服回复太慢",
        "找不到帮助文档",
        "密码找回找不到入口"
      ],
      "expected": {
        "topicCountMin": 3,
        "mustClusterKeywords": {
          "登录类": ["登录", "验证码", "密码"],
          "界面类": ["界面", "颜色"],
          "性能类": ["加载", "速度"]
        }
      }
    }
  ]
}
