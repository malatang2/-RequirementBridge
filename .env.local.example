# ============================================================
# RequirementBridge 环境变量模板
# 复制为 .env.local 并填入真实值（.env.local 不入库）
# ============================================================

# ---------- Supabase ----------
# 项目 URL（控制台 > Project Settings > API）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# 浏览器端 anon key（受 RLS 保护）
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 服务端 service_role key（绕过 RLS，仅服务端使用，勿暴露）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- 阿里云百炼 / DashScope（CP0：由 OpenAI 迁移）----------
# 百炼控制台开通，获取 API Key
DASHSCOPE_API_KEY=your-dashscope-api-key
# OpenAI 兼容端点（默认值，一般无需改）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
